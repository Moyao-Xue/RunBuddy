@import url("https://cdnjs.cloudflare.com/ajax/libs/meyer-reset/2.0/reset.min.css");
@import url("https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;500;600;700&display=swap");

:root {
  --bg-shell: #edd3ae;
  --panel-main: rgba(159, 204, 224, 0.92);
  --panel-sub: rgba(242, 242, 247, 0.92);
  --text-main: #1a1a1a;
  --text-soft: #2b2b2b;
  --line: #000000;
  --accent: #1f7a8c;
  --danger: #bf3f3f;
  --route: #2577d9;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  height: 100%;
}

body {
  background: #f0f0f0;
  font-family: "Pixelify Sans", sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px;
}

.iphone {
  position: relative;
  width: 393px;
  max-width: 100%;
  height: 852px;
  overflow: hidden;
  background: var(--bg-shell);
  border: 2px solid var(--line);
}

.map-shell {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.map-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.map-status {
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 86px;
  margin: 0;
  padding: 8px 10px;
  font-size: 13px;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.65);
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.35);
  z-index: 10;
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
}

.runner-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.top-bar {
  position: absolute;
  top: 12px;
  left: 12px;
  right: 12px;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 10px;
  border: 2px solid var(--line);
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.page-title {
  margin: 0;
  font-size: 30px;
  line-height: 1;
  color: #78444d;
  letter-spacing: 0.02em;
}

.icon-btn {
  width: 38px;
  height: 38px;
  border: 2px solid var(--line);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.92);
  padding: 0;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease;
}

.icon-btn img {
  width: 22px;
  height: 22px;
  object-fit: contain;
}

.icon-btn:active {
  transform: translateY(1px) scale(0.98);
}

.stats-panel {
  position: absolute;
  top: 82px;
  right: 12px;
  width: 176px;
  z-index: 25;
  padding: 10px;
  border: 2px solid var(--line);
  background: var(--panel-main);
}

.stats-text {
  display: grid;
  gap: 8px;
  font-size: 13px;
  color: var(--text-main);
}

.stats-text p {
  margin: 0;
  line-height: 1.25;
}

#statCaloriesLine {
  color: #2f2f2f;
}

#statCalories {
  color: #f08a2d;
  font-weight: 700;
}

.game-controls {
  position: absolute;
  left: 12px;
  right: 196px;
  bottom: 18px;
  z-index: 30;
  display: flex;
  gap: 10px;
}

.control-btn {
  flex: 1;
  height: 52px;
  border: 2px solid var(--line);
  cursor: pointer;
  font-family: "Pixelify Sans", sans-serif;
  font-size: 22px;
  font-weight: 600;
  color: #111;
  transition: transform 0.18s ease;
}

.control-btn-primary {
  background: #9fccdf;
}

.control-btn-danger {
  background: #edb8ae;
}

.control-btn:active {
  transform: translateY(1px) scale(0.98);
}

.skip-link {
  position: absolute;
  top: -46px;
  left: 10px;
  z-index: 200;
  padding: 8px 10px;
  font-size: 12px;
  color: #fff;
  background: #222;
  text-decoration: none;
  border-radius: 4px;
}

.skip-link:focus {
  top: 10px;
}

button:focus-visible,
input:focus-visible,
select:focus-visible,
.skip-link:focus-visible {
  outline: 3px solid #2a7ccf;
  outline-offset: 2px;
}

.modal-overlay {
  position: absolute;
  inset: 0;
  z-index: 90;
  display: none;
  background: rgba(0, 0, 0, 0.58);
}

.settings-modal,
.warning-modal,
.info-modal {
  position: absolute;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 100;
  display: none;
  width: 322px;
  border: 2px solid var(--line);
  background: rgba(242, 242, 247, 0.97);
  padding: 18px 16px 16px;
}

.settings-modal {
  top: 50%;
}

.warning-modal {
  top: 50%;
  background: rgba(255, 235, 235, 0.98);
}

.info-modal {
  top: 48%;
  background: rgba(219, 243, 229, 0.98);
}

.modal-close-btn,
.warning-close-btn,
.info-close-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 34px;
  height: 34px;
  border: 2px solid var(--line);
  border-radius: 6px;
  background: #ffffff;
  padding: 0;
  cursor: pointer;
}

.modal-close-btn img,
.warning-close-btn img,
.info-close-btn img {
  width: 100%;
  height: 100%;
}

.modal-title,
.warning-title,
.info-title {
  margin: 0 0 14px;
  text-align: center;
  font-size: 34px;
  color: #78444d;
}

.warning-title {
  color: var(--danger);
}

.modal-content {
  display: grid;
  gap: 12px;
}

.modal-item {
  display: grid;
  grid-template-columns: 88px 1fr;
  align-items: center;
  gap: 10px;
}

.modal-item label {
  font-size: 16px;
  color: var(--text-main);
}

.speed-wrap,
.modal-select {
  width: 100%;
  height: 38px;
  border: 2px solid var(--line);
  background: #fff;
}

.speed-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 8px;
}

.speed-wrap input {
  flex: 1;
  border: 0;
  background: transparent;
  font-family: "Pixelify Sans", sans-serif;
  font-size: 16px;
  text-align: right;
  outline: none;
}

.unit {
  font-size: 13px;
}

.modal-select {
  font-family: "Pixelify Sans", sans-serif;
  font-size: 16px;
  padding: 0 8px;
}

.warning-text,
.info-text {
  margin: 0;
  text-align: center;
  line-height: 1.45;
  font-size: 17px;
  color: #222;
}

.warning-speaker {
  position: absolute;
  right: 14px;
  top: 58%;
  z-index: 105;
  width: 42px;
  height: 42px;
  display: none;
}

.leaflet-control-container .leaflet-top,
.leaflet-control-container .leaflet-bottom {
  z-index: 9;
}

/* Avoid visible tile seams / block artifacts on some GPU pipelines */
.map-canvas .leaflet-pane,
.map-canvas .leaflet-tile-pane,
.map-canvas .leaflet-map-pane,
.map-canvas .leaflet-tile-container {
  transform: translate3d(0, 0, 0);
  will-change: transform;
}

.map-canvas .leaflet-tile {
  image-rendering: auto;
  backface-visibility: hidden;
}

.route-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 2px solid #fff;
  background: var(--route);
  box-shadow: 0 0 0 2px rgba(37, 119, 217, 0.28);
}

@media (max-width: 440px) {
  body {
    padding: 0;
  }

  .iphone {
    width: 100vw;
    height: 100vh;
    border-width: 0;
  }

  .stats-panel {
    width: 170px;
  }

  .game-controls {
    right: 188px;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
    animation: none !important;
  }
}
