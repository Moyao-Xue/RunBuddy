<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta charset="utf-8" />
  <meta name="description" content="RunBuddy - Real-world running tracker with live map route">
  <title>RunBuddy - Running</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <link rel="stylesheet" href="css/running.css">
</head>
<body>

<a href="#game-controls" class="skip-link">Skip to game controls</a>
<a href="#statsPanel" class="skip-link">Skip to statistics</a>

<main class="iphone" aria-label="Real-world running tracker">
  <section class="map-shell" aria-label="Live map">
    <div id="map" class="map-canvas" role="application" aria-label="Interactive running map"></div>
    <p class="map-status" id="mapStatus" aria-live="polite">Waiting for location permission...</p>
  </section>

  <img class="runner-hidden" id="runner" src="images/stand.png" alt="Runner avatar" />

  <header class="top-bar">
    <button class="icon-btn" id="backBtn" aria-label="Return to menu">
      <img src="images/pointer-left.svg" alt="" aria-hidden="true">
    </button>
    <h1 class="page-title">Running</h1>
    <button class="icon-btn" id="settingBtn" aria-label="Open settings">
      <img src="images/setting-up.png" alt="" aria-hidden="true">
    </button>
  </header>

  <section class="stats-panel" id="statsPanel" role="status" aria-label="Running statistics">
    <div class="stats-text">
      <p id="statTime" aria-live="polite">Time: 00:00:00</p>
      <p id="statPace" aria-live="polite">Pace: 0.0 km/h</p>
      <p id="statDistance" aria-live="polite">Distance: 0.00 km</p>
      <p id="statHeartRate" aria-live="polite">Heart rate: 0 bpm</p>
    </div>
  </section>

  <section class="calories-panel" id="caloriesPanel" role="status" aria-label="Calories burned">
    <div class="calories-text">Calories</div>
    <div class="calories-value"><span id="statCalories" aria-live="polite">0</span> kcal</div>
  </section>

  <nav class="game-controls" id="game-controls" aria-label="Game controls">
    <button class="control-btn control-btn-primary" id="startBtn" aria-label="Start or pause running">Start</button>
    <button class="control-btn control-btn-danger" id="endBtn" aria-label="End run">End</button>
  </nav>

  <div class="modal-overlay" id="modalOverlay"></div>

  <div class="settings-modal" id="settingsModal" role="dialog" aria-labelledby="settingsTitle" aria-modal="true">
    <button class="modal-close-btn" id="modalClose" aria-label="Close settings">
      <img src="images/close-up.png" alt="close">
    </button>
    <h2 class="modal-title" id="settingsTitle">Setting</h2>

    <div class="modal-content">
      <div class="modal-item">
        <label for="speedInput">Min Speed:</label>
        <div class="speed-wrap">
          <input type="text" id="speedInput" class="modal-input">
          <span class="unit">km/h</span>
        </div>
      </div>
      <div class="modal-item">
        <label for="maxHrInput">Max HR:</label>
        <div class="speed-wrap">
          <input type="text" id="maxHrInput" class="modal-input">
          <span class="unit">bpm</span>
        </div>
      </div>
      <div class="modal-item">
        <label for="musicSelect">Music:</label>
        <select id="musicSelect" class="modal-select">
          <option value="audio/faded.mp3">Music 1</option>
          <option value="audio/baby.mp3">Music 2</option>
          <option value="audio/cruelSummer.mp3">Music 3</option>
        </select>
      </div>
    </div>
  </div>

  <div class="warning-modal" id="warningModal" role="alertdialog" aria-labelledby="warningTitle" aria-describedby="warningText" aria-modal="true">
    <button class="warning-close-btn" id="warningClose" aria-label="Close warning">
      <img src="images/close-up.png" alt="close">
    </button>
    <h2 class="warning-title" id="warningTitle">Warning</h2>
    <p class="warning-text" id="warningText">
      your pace too slow!<br>
      Pay attention to your exercise intensity.
    </p>
  </div>

  <img class="warning-speaker" id="warningSpeaker" src="images/horn.png" alt="speaker">

  <div class="info-modal" id="infoModal" role="dialog" aria-labelledby="infoTitle" aria-describedby="infoText" aria-modal="true">
    <button class="info-close-btn" id="infoClose" aria-label="Close">
      <img src="images/close-up.png" alt="close">
    </button>
    <h2 class="info-title" id="infoTitle">Award</h2>
    <p class="info-text" id="infoText">
      Congratulation! You have gained a coin
    </p>
  </div>
</main>

<audio id="bgMusic" src="audio/faded.mp3" loop preload="auto"></audio>
<audio id="encourageAudio" preload="auto"></audio>
<audio id="coinsAudio" src="audio/coinsSound.mp3" preload="auto"></audio>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="js/storage.js"></script>
<script src="js/game.js"></script>
</body>
</html>
